# The build context is the repository root, so without this file the frontend,
# .git and the virtualenv would all be shipped to the daemon and every build
# would wait on gigabytes of upload.

.git/
.gitignore
.gitattributes

# Secrets never reach the image
.env

# The frontend has its own Dockerfile
frontend/
node_modules/
dist/

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

.idea/
.vscode/
.DS_Store

README.md
ARCHITECTURE.md