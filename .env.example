# Copy to .env: cp .env.example .env
# The defaults are enough to bring the whole stack up without any edits.

# --- PostgreSQL ---
POSTGRES_USER=trend
POSTGRES_PASSWORD=trend
POSTGRES_DB=trend_radar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (broker + cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Auth ---
# Replace in production: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# The admin user is created automatically on API startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- LLM ---
# anthropic | openai | gemini | grok | none
# none = deterministic formula (fallback). No key required, and this is the
# mode the project ships in so it starts out of the box.
LLM_PROVIDER=none
LLM_API_KEY=
# Empty means the provider default:
#   anthropic -> claude-sonnet-5
#   openai    -> gpt-4o-mini
#   gemini    -> gemini-3.6-flash
#   grok      -> grok-4
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# How long one run may spend on scoring. 40 products are scored one after
# another, so a slow or retrying provider could otherwise eat the whole Celery
# soft limit (28 min) and have the task killed mid-run. When the budget is gone
# the remaining products fall to the formula and the run still finishes.
SCORING_BUDGET_SECONDS=900

# --- Scraping ---
# Category pages, comma separated. Category pages rather than the root
# /Best-Sellers/zgbs: on the root every product would be labelled
# "Amazon Best Sellers" and the Sales Boost by category would become
# meaningless, matching either everything at once or nothing.
AMAZON_CATEGORY_URLS=https://www.amazon.com/Best-Sellers-Electronics/zgbs/electronics,https://www.amazon.com/Best-Sellers-Home-Kitchen/zgbs/home-garden,https://www.amazon.com/Best-Sellers-Toys-Games/zgbs/toys-and-games,https://www.amazon.com/Best-Sellers-Sports-Outdoors/zgbs/sporting-goods,https://www.amazon.com/Best-Sellers-Beauty/zgbs/beauty
# Per category, not per run. 5 categories x 8 = 40 products.
SCRAPE_MAX_PRODUCTS=8
SCRAPE_INTERVAL_HOURS=6
PLAYWRIGHT_HEADLESS=true
# Optional: http://user:pass@host:port
SCRAPE_PROXY=
# Amazon blocks some IP ranges. When the live scrape fails we fall back to the
# bundled snapshot in app/seed_data/ so the dashboard is not empty. Such a run
# is marked 'partial' rather than 'success' to keep the block visible.
SCRAPE_SNAPSHOT_FALLBACK=true

# --- CORS ---
# Comma separated. 3011 is the frontend container, 5173 is `npm run dev`.
CORS_ORIGINS=http://localhost:3011,http://localhost:5173

# --- Host ports ---
# Deliberately non-default so the stack does not clash with other local
# projects. Inside the Docker network the services use standard ports.
POSTGRES_EXTERNAL_PORT=5442
REDIS_EXTERNAL_PORT=6390
API_EXTERNAL_PORT=8011
FRONTEND_EXTERNAL_PORT=3011

# --- Misc ---
LOG_LEVEL=INFO
