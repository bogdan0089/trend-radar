# Скопіюй у .env: cp .env.example .env
# Значень за замовчуванням достатньо, щоб проєкт піднявся без жодних правок.

# --- PostgreSQL ---
POSTGRES_USER=trend
POSTGRES_PASSWORD=trend
POSTGRES_DB=trend_radar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (broker + cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Auth ---
# У проді замінити на випадковий рядок: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Адмін створюється автоматично при старті API. Цей логін/пароль — у README.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- LLM ---
# anthropic | openai | none
# none = детермінована математична формула (fallback). Ключ не потрібен.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- Скрапінг ---
AMAZON_CATEGORY_URL=https://www.amazon.com/Best-Sellers/zgbs
SCRAPE_MAX_PRODUCTS=20
SCRAPE_INTERVAL_HOURS=6
PLAYWRIGHT_HEADLESS=true
# Опційно: http://user:pass@host:port
SCRAPE_PROXY=
# Amazon блокує частину IP. Коли живий збір не пройшов — беремо демо-снапшот
# з app/seed_data/, щоб панель не була порожньою. Такий запуск позначається
# статусом 'partial', а не 'success'.
SCRAPE_SNAPSHOT_FALLBACK=true

# --- Порти на хості ---
# Навмисно нестандартні, щоб не конфліктувати з іншими локальними стеками.
# Всередині мережі Docker сервіси спілкуються стандартними портами.
POSTGRES_EXTERNAL_PORT=5442
REDIS_EXTERNAL_PORT=6390
API_EXTERNAL_PORT=8011
FRONTEND_EXTERNAL_PORT=3011

# --- Інше ---
LOG_LEVEL=INFO